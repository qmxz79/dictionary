<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Language Badge + Word + Action Icons (TTS, Star, Copy) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLangBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_english"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="英语"
                android:textColor="@color/tag_english"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="selamat" />

            <!-- TTS Speaker -->
            <ImageButton
                android:id="@+id/btnSpeak"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="发音"
                android:src="@drawable/ic_volume" />

            <!-- Favorite Star -->
            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="收藏"
                android:src="@drawable/ic_star_border" />

            <!-- Copy Button -->
            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="复制"
                android:src="@drawable/ic_copy" />
        </LinearLayout>

        <!-- Phonetic & POS -->
        <LinearLayout
            android:id="@+id/layoutPhonetic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPhonetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="/səˈlɑːmæt/" />

            <TextView
                android:id="@+id/tvPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="italic"
                tools:text="adj./n." />
        </LinearLayout>

        <!-- Root Word Note (Malay Stemming) -->
        <TextView
            android:id="@+id/tvStemInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tag_malay"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/tag_malay"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="💡 词根还原: makan (吃) + 前缀 me-"
            tools:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/divider" />

        <!-- Definition (Chinese Translation) -->
        <TextView
            android:id="@+id/tvDefinition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="1. 平安，安全；恭祝\n2. 早上好 (Selamat pagi)" />

        <!-- Example Sentence -->
        <TextView
            android:id="@+id/tvExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="例句: Selamat pagi, cikgu."
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
