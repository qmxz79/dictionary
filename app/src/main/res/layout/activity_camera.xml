<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX Preview View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Captured Photo Preview (for Photo & Gallery mode) -->
    <ImageView
        android:id="@+id/ivCapturedPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- AR Transparent Overlay Layer -->
    <com.bilingual.dictionary.ocr.GraphicOverlay
        android:id="@+id/graphicOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="10dp"
            android:src="@drawable/ic_clear"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvCameraTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="实时取景 AR 翻译"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Flash Light Toggle -->
        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="闪光灯"
            android:padding="10dp"
            android:src="@drawable/ic_flash_off" />

        <!-- Switch Camera Lens -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="翻转镜头"
            android:padding="10dp"
            android:src="@drawable/ic_switch_camera" />
    </LinearLayout>

    <!-- Center Tip Hint -->
    <TextView
        android:id="@+id/tvLiveHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_bottom_sheet_handle"
        android:backgroundTint="#B3000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="将镜头对准英语或马来语单词，点击浮框可查详细释义"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- OCR Processing Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBarOcr"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Control Panel -->
    <LinearLayout
        android:id="@+id/bottomControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_camera_control_bar"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Mode Toggle Chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCameraMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipModeLive"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="🎥 实时取景 AR"
                android:textColor="#FFFFFF" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipModePhoto"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 拍照 / 相册"
                android:textColor="#FFFFFF" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Capture / Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Gallery Import Button -->
            <ImageButton
                android:id="@+id/btnGallery"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="相册导入"
                android:padding="12dp"
                android:src="@drawable/ic_gallery" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Shutter Button (Takes Photo) -->
            <ImageButton
                android:id="@+id/btnShutter"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="拍照"
                android:src="@drawable/ic_shutter" />

            <!-- Retake Button (Shown in Photo Mode after capture) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetake"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="重拍"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Spacer for Balance -->
            <View
                android:layout_width="52dp"
                android:layout_height="52dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
